<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：曜石黑底 + 薄荷绿主色，强制深色（高端简约，避免系统浅色打断观影氛围）-->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_surface</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="android:navigationBarColor">@color/brand_surface</item>
        <item name="android:statusBarColor">@color/brand_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/brand_surface</item>
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="android:navigationBarColor">@color/brand_surface</item>
        <item name="android:statusBarColor">@color/brand_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- 启动屏：曜石黑纯色，避免白闪 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/brand_surface</item>
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
